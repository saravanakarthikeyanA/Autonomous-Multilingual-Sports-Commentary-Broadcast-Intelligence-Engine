# Environment Variables Configuration
# Groq API Configuration (Free Tier LLMs & Whisper-v3 Speech-to-Text)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FAST_MODEL=qwen/qwen3.8-27b

# Hugging Face Configuration (Optional for Kokoro Serverless TTS)
HF_TOKEN=your_huggingface_token_here

# Database & Storage
DB_PATH=data/match_stats.db
AUDIO_OUTPUT_DIR=data/audio_cache

# ==============================================================================
# Cloud Offloaded Observability & LLM Evaluation (100% Free External Dashboards)
# ==============================================================================
# 1. External Hosted MLflow (e.g. Free DagsHub: https://dagshub.com)
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_EXPERIMENT_NAME=Cricket_Commentary_Evaluation

# 2. External Hosted Grafana (e.g. Free Grafana Cloud: https://grafana.com)
GRAFANA_CLOUD_URL=

# ==============================================================================
# AWS Configuration (Optional: When connecting to AWS RDS / S3)
# ==============================================================================
AWS_REGION=us-east-1
S3_BUCKET_NAME=cricsheet-data
RDS_POSTGRES_HOST=localhost
RDS_POSTGRES_PORT=5432
RDS_POSTGRES_DB=cricket_stats
RDS_POSTGRES_USER=postgres
RDS_POSTGRES_PASSWORD=postgres
