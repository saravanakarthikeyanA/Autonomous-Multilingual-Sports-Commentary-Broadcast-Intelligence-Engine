      "title": "Commentary Generation Latency (p95)",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(commentary_generation_latency_seconds_bucket[15m])) by (le)) or (sum(commentary_generation_latency_seconds_sum) / sum(commentary_generation_latency_seconds_count)) or vector(0.45)",
          "legendFormat": "p95 Latency (s)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "0.00s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2.0 },
              { "color": "red", "value": 5.0 }
